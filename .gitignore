# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# uv: uv.lock is committed, the environment is not
.python-version

# Secrets: never commit keys
*.key
*.pem
# Public TSA root certificate fixture (not a secret; needed to verify tests/fixtures/tsa/*.tsr)
!tests/fixtures/tsa/*.pem

# Data directories and real logs (fixtures belong under tests/)
data/
*.jsonl
!tests/**/*.jsonl
# Synthetic example log in the design-phase material (generated by its make_example_log.py)
!research/**/examples/*.jsonl
# The TurtleBot 4 integration notes' worked example (section B.5)
!research/turtlebot4/*.jsonl

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# TurtleBot 4 demo and ROS 2 builds
demo/tb4-sim/run/
connectors/ros2/build/
connectors/ros2/install/
connectors/ros2/log/
# LeRobot demo downloads, logs and report
demo/lerobot/run/
