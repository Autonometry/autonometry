{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonometry.github.io/spec/v0.3/task_registry.schema.json",
  "title": "Autonometry task registry (v0.3)",
  "description": "The tasks declared before the session (definitions.md v0.3 section 1, Task). A task_definition_id must not repeat. Its SHA-256 in RFC 8785 canonical form is session_start.task_registry_hash. Fields starting with x_ are extensions.",
  "type": "object",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "task": {
      "type": "object",
      "properties": {
        "task_definition_id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "maxLength": 500 }
      },
      "required": ["task_definition_id"],
      "patternProperties": { "^x_[a-z0-9_]+$": {} },
      "additionalProperties": false
    }
  },
  "properties": {
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
  },
  "required": ["tasks"],
  "patternProperties": { "^x_[a-z0-9_]+$": {} },
  "additionalProperties": false,
  "examples": [
    {
      "tasks": [
        { "task_definition_id": "pick_place_v1", "description": "Pick a cube from bin A and place it in bin B." },
        { "task_definition_id": "dock_v1" }
      ]
    }
  ]
}
