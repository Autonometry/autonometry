{
  "devices": [
    {
      "device_id": "nav2",
      "kind": "ai",
      "match": {
        "node": "/collision_monitor"
      },
      "x_note": "Nav2's collision monitor relays cmd_vel_smoothed to /cmd_vel; its commands are the AI's only while the whole chain is"
    },
    {
      "device_id": "nav2_bt_navigator",
      "kind": "ai",
      "match": {
        "node": "/bt_navigator"
      },
      "x_note": "executes task goals; starts recoveries (spin, backup) itself"
    },
    {
      "device_id": "nav2_controller",
      "kind": "ai",
      "match": {
        "node": "/controller_server"
      },
      "x_note": "publishes cmd_vel_nav"
    },
    {
      "device_id": "nav2_behaviors",
      "kind": "ai",
      "match": {
        "node": "/behavior_server"
      },
      "x_note": "spin, backup, drive_on_heading, assisted_teleop; publishes cmd_vel_nav"
    },
    {
      "device_id": "nav2_smoother",
      "kind": "ai",
      "match": {
        "node": "/velocity_smoother"
      },
      "x_note": "cmd_vel_nav to cmd_vel_smoothed"
    },
    {
      "device_id": "nav2_waypoint_follower",
      "kind": "ai",
      "match": {
        "node": "/waypoint_follower"
      },
      "x_note": "sends navigate_to_pose goals inside a follow_waypoints task"
    },
    {
      "device_id": "mission_navigator",
      "kind": "ai",
      "match": {
        "node": "/basic_navigator"
      },
      "x_note": "a TurtleBot4Navigator or BasicNavigator mission script: its goals and dock or undock requests are the AI's"
    },
