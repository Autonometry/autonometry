    },
    {
      "device_id": "joy_copy",
      "kind": "human",
      "location": "remote",
      "match": {
        "topic": "/cmd_vel",
        "node": "/joy"
      }
    },
    {
      "device_id": "joy_other_topic",
      "kind": "human",
      "location": "local",
      "match": {
        "node": "/joy",
        "topic": "/cmd_vel_safe"
      }
    }
  ]
}
